---
import '../style.css'
---

<footer class="footer">
    <div class="left">
        <p>Copyright © 2026 <a href="https://github.com/GoobusTheNoobus">David Huang ↗</a>.</p>
        <p>All rights reserved.</p>
    </div>
    <div class="right">
        <p>
            <i>"An idiot admires complexity, a genius admires simplicity."</i> - Terry A. Davis
        </p>
        <strong>
            Made with minimalism, made without AI slop.
        </strong>
    </div>
</footer>

<style>

    footer {
        margin: auto 0 0;
        padding: 1rem 2rem;

        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;

        align-items: center;
        font-size: 0.9rem;

        color: var(--color-mute);
        border-top: solid 1px var(--color-border);
    }

    footer p {
        line-height: 1rem;
    }

    footer .right {
        text-align: right;
    }

</style>